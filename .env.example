# Replace with your own WeatherAPI.com key. Do not commit the real .env file.
WEATHERAPI_KEY=replace_with_your_weatherapi_key

# Local PostgreSQL warehouse credentials. Replace the sample password.
POSTGRES_USER=weatherflow
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_DB=weatherflow
DATABASE_URL=postgresql://weatherflow:replace_with_a_local_password@localhost:5433/weatherflow
